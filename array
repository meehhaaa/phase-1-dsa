ques) reverse the array

#include<iostream>

using namespace std;
main() {
    int arr[5] = {1,2,4,6,8};
    int i=0,  j=4;
    while(i<=j){
        swap(arr[i],arr[j]);
        i++;
        j--;
    }
    for(int k = 0; k < 5; k++) {
    cout << arr[k] << " ";
    }
}  
