ques)print odd and even by the help of array

#include <bits/stdc++.h>
#include<iostream>
using namespace std;

main(){
    int arr[5] = {1,3,2,5,6};
    
    int even = 0; int odd = 0;
    for(int i = 0; i<=4; i++){
        if(arr[i]%2==0){
        even += arr[i]; 
    }
    else{
        odd += arr[i];
    }
    cout<<odd<<" "<<even;
}
}

