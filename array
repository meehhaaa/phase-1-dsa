ques) sum of all element in array

#include<iostream>
using namespace std;

main(){
    int arr[5] = {2,3,1,0,6}
    
    int sum = 0;
    for(int i = 0; i<=4; i++){
        sum = sum + arr[i];
    }
    cout<<sum;
}
