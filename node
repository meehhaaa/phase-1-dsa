#include <bits/stdc++.h>
using namespace std;

// Node class
class Node {
public:
    int data;
    Node* next;

    Node(int v) {
        data = v;
        next = NULL;
    }
};

// Stack class
class Stack {
    Node* head;

public:
    Stack() {
        head = NULL;
    }

    // Push operation
    void push(int v) {
        Node* n = new Node(v);

        n->next = head;
        head = n;
    }

    // Pop operation
    void pop() {
        if (head == NULL) {
            cout << "Stack Underflow" << endl;
            return;
        }

        Node* temp = head;
        head = head->next;
        delete temp;
    }

    // Top element
    void top() {
        if (head == NULL) {
            cout << "Stack is Empty" << endl;
            return;
        }

        cout << "Top Element: " << head->data << endl;
    }

    // Display stack
    void display() {
        Node* temp = head;

        while (temp != NULL) {
            cout << temp->data << " ";
            temp = temp->next;
        }

        cout << endl;
    }
};

int main() {
    Stack s;

    s.push(10);
    s.push(20);
    s.push(30);

    s.display();

    s.top();

    s.pop();

    s.display();

    return 0;
}
