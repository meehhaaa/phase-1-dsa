#include <bits/stdc++.h>
using namespace std;

// Node class
class Node {
public:
    int data;
    Node* next;

    Node(int v) {
        data = v;
        next = NULL;
    }
};

// Stack class
class Stack {
    Node* head;

public:
    Stack() {
        head = NULL;
    }

    // Push operation
    void push(int v) {

        if (head == NULL) {
            Node* n = new Node(v);
            head = n;
        }
        else {
            Node* n = new Node(v);
            n->next = head;
            head = n;
        }
    }

    // Pop operation
    void pop() {

        if (head == NULL) {
            cout << "Stack Underflow" << endl;
            return;
        }

        Node* n = head->next;
        delete head;
        head = n;
    }

    // Check empty
    bool empty() {

        if (head == NULL) {
            return true;
        }
        else {
            return false;
        }
    }

    // Top element
    int top() {

        if (head == NULL) {
            cout << "Stack is Empty" << endl;
            return -1;
        }

        return head->data;
    }
};

int main() {

    Stack s;

    s.push(1);
    s.push(2);
    s.push(3);

    cout << s.top() << endl;

    s.pop();

    cout << s.top() << endl;

    return 0;
}
