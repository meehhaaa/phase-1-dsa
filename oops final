//multiple inheritance


#include <iostream>
using namespace std;
class Human {
protected: //parent
	string name;
};
class person //parent 2
{
	protected:
	int age;

};
	class student : public Human, public person//child of multiple parent
	{
		int roll_no;
	public:

		student(string n, int a, int r)
		{
			name=n;
			age=a;
			roll_no=r;

		}
		void display()
		{
		    cout<<name<<" " << age <<" "<< roll_no <<endl;
		}
	};

int main() {
	student obj("mehaaaa", 27,67);
	obj.display();

}
