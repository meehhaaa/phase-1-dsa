//adding 2 complex number using operator overloading in polymorphism 

#include <bits/stdc++.h>

using namespace std;
class complex {
    int real;
    int img;
    
    public:
    complex()
    {
        
    }
        complex(int real, int img)
        {
            this -> real = real;
            this -> img = img;

        }
        complex operator + (complex &c){
            complex ans;
            ans.real= real+c.real;
            ans.img = img+c.img;
            return ans;
            
        }
    void display()
    {
        cout << real << "+i" << img << endl;

    }


};

int main() {
    complex c1(3,4);
    complex c2(2,4);
    complex c3 = c1+c2;
    c3.display();

}































