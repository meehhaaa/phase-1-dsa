Given a positive integer, n. Find the factorial of n
#include<iostream>
using namespace std;

int factorial(int n)
{
    // Base case
    if(n==0 || n==1)
        return 1;

    // Recursive call
    return n * factorial(n-1);
}

int main()
{
    int n;
    cin >> n;

    cout << factorial(n);

    return 0;
}
