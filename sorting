ques) insertion sort


#include <bits/stdc++.h>
using namespace std;

int main(){
    int arr[5]={5,4,3,2,1};
    int n=5;
    for(int i=1;i<n-1;i++)
    {
        for(int j = 0; j>0; j--){
        if(arr[j]>arr[j-1]){
            swap(arr[j],arr[j-1]);
            
        }
        
    }
    }
    for(int i =0; i<n; i++){
    cout<<arr[i]<<" ";
}
return 0;
}
    
