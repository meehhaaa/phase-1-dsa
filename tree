POSTORDER
class Solution {

    void solve(TreeNode* root, vector<int> &arr) {

        // Base case
        if(root == NULL) {
            return;
        }

        // Left
        solve(root->left, arr);

        // Right
        solve(root->right, arr);

        // Root
        arr.push_back(root->val);
    }

public:

    vector<int> postorderTraversal(TreeNode* root) {

        vector<int> arr;

        solve(root, arr);

        return arr;
    }
};


